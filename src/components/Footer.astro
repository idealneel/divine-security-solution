---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import { config } from '../config';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<footer class="bg-primary-dark text-white">
  <div class="max-w-[1100px] mx-auto px-5 md:px-8 py-14 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-8">
      {/* Column 1: Logo + name */}
      <div>
        <div class="flex items-center gap-2.5 mb-4">
          <img src="/photos/logo/logo-shield-lens.png" alt="" class="h-8 w-auto object-contain brightness-0 invert" />
          <span class="font-heading font-semibold text-[15px]">{config.businessName}</span>
        </div>
        <p class="text-blue-200 text-sm leading-relaxed">
          {lang === 'en'
            ? 'CCTV, RO, EPBX, biometric and AMC services since 2012.'
            : 'CCTV, RO, EPBX, बायोमेट्रिक आणि AMC सेवा २०१२ पासून.'}
        </p>
      </div>

      {/* Column 2: Services */}
      <div>
        <h3 class="font-heading font-semibold text-sm mb-4">{t('footer.services')}</h3>
        <ul class="space-y-2">
          {config.services.map((service) => (
            <li class="text-blue-200 text-sm">{service[lang].title}</li>
          ))}
        </ul>
      </div>

      {/* Column 3: Contact + Areas */}
      <div>
        <h3 class="font-heading font-semibold text-sm mb-4">{t('footer.contact')}</h3>
        <div class="space-y-2 text-sm text-blue-200">
          <p>{config.areas.join(' · ')}</p>
          <p>
            <a href={config.whatsappUrl} class="hover:text-white transition-colors duration-150">
              {t('footer.whatsapp')}: {config.whatsappNumber}
            </a>
          </p>
        </div>
      </div>
    </div>

    {/* Bottom bar */}
    <div class="border-t border-white/10 mt-10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-blue-300">{t('footer.copyright')}</p>
      <div class="flex items-center gap-4 text-xs text-blue-300">
        <a href={translatePath('/privacy/')} class="hover:text-white transition-colors duration-150">{t('footer.privacy')}</a>
        <a href={translatePath('/terms/')} class="hover:text-white transition-colors duration-150">{t('footer.terms')}</a>
      </div>
    </div>

    {/* Credit */}
    <div class="mt-4 text-center">
      <p class="text-[11px] text-blue-400">
        Made with <a href="https://www.siteaddict.shop/" target="_blank" rel="noopener noreferrer" class="text-accent hover:text-white transition-colors duration-150">Site Addict</a>
      </p>
    </div>
  </div>
</footer>
