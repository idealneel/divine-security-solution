---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { config } from '../config';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="about" class="bg-white">
  <div class="max-w-[1100px] mx-auto px-5 md:px-8 py-20 md:py-28">
    {/* Section heading */}
    <div class="mb-12">
      <span class="text-[15px] uppercase tracking-widest text-primary font-medium">{t('about.label')}</span>
      <div class="w-12 h-[3px] bg-accent mt-1 mb-2"></div>
      <h2 class="font-heading font-semibold text-[30px] md:text-[40px] text-primary">{t('about.heading')}</h2>
    </div>

    <div class="flex flex-col md:flex-row items-center md:items-start gap-10 md:gap-16">
      {/* Photo */}
      <div class="w-full md:w-[400px] shrink-0">
        <img
          src="/photos/hero/pexels-mateusz-feliksik-1896604-13422379.jpg"
          alt="CCTV camera installation"
          class="w-full rounded-lg aspect-[3/2] object-cover"
          loading="lazy"
        />
      </div>

      {/* Text */}
      <div class="flex-1">
        <p class="text-slate-body text-[16px] md:text-[17px] leading-[1.7] mb-6">
          {t('about.intro')}
        </p>
        <div class="border-t border-gray-100 pt-4">
          <p class="text-sm text-gray-500 mb-1">{t('about.clients')}</p>
          <p class="text-sm text-primary font-medium">
            {config.notableClients.join(' · ')}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
