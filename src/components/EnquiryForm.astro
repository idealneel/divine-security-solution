---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { config, type ServiceId } from '../config';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const serviceLabels: Record<ServiceId, Record<string, string>> = {
  cctv: { en: 'CCTV Installation & Repair', mr: 'CCTV इन्स्टॉलेशन आणि दुरुस्ती' },
  ro: { en: 'RO Water Purifier', mr: 'RO वॉटर प्युरिफायर' },
  epbx: { en: 'EPBX Systems', mr: 'EPBX सिस्टम' },
  biometric: { en: 'Biometric & Access Control', mr: 'बायोमेट्रिक आणि अॅक्सेस कंट्रोल' },
  amc: { en: 'Annual Maintenance (AMC)', mr: 'वार्षिक मेंटेनन्स (AMC)' },
};
---

<section id="contact" class="bg-white">
  <div class="max-w-[1100px] mx-auto px-5 md:px-8 py-20 md:py-28">
    {/* Section heading */}
    <div class="mb-12">
      <span class="text-[15px] uppercase tracking-widest text-primary font-medium">{t('form.label')}</span>
      <div class="w-12 h-[3px] bg-accent mt-2.5 mb-4"></div>
      <h2 class="font-heading font-semibold text-[30px] md:text-[40px] text-primary">{t('form.heading')}</h2>
    </div>

    <form id="enquiry-form" class="max-w-[560px]" novalidate>
      {/* Services checkboxes */}
      <fieldset class="mb-6">
        <legend class="text-sm font-medium text-primary mb-3">{t('form.services')} *</legend>
        <div class="flex flex-col gap-2.5">
          {config.services.map((service) => (
            <label class="flex items-center gap-3 cursor-pointer group">
              <input
                type="checkbox"
                name="services"
                value={service.id}
                class="w-4 h-4 rounded border-gray-300 text-accent focus:ring-accent/30"
              />
              <span class="text-sm text-slate-body group-hover:text-primary transition-colors duration-150">
                {serviceLabels[service.id][lang]}
              </span>
            </label>
          ))}
        </div>
        <p id="service-error" class="hidden text-red-500 text-xs mt-2">{t('form.required')}</p>
      </fieldset>

      {/* Name */}
      <div class="mb-4">
        <label for="name" class="block text-sm font-medium text-primary mb-1.5">{t('form.name')}</label>
        <input
          type="text"
          id="name"
          name="name"
          placeholder={t('form.namePlaceholder')}
          class="w-full px-4 py-2.5 rounded-lg border border-gray-200 text-sm text-slate-body placeholder:text-gray-400 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/20 transition-colors duration-150"
        />
      </div>

      {/* Location */}
      <div class="mb-4">
        <label for="location" class="block text-sm font-medium text-primary mb-1.5">{t('form.location')}</label>
        <input
          type="text"
          id="location"
          name="location"
          placeholder={t('form.locationPlaceholder')}
          class="w-full px-4 py-2.5 rounded-lg border border-gray-200 text-sm text-slate-body placeholder:text-gray-400 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/20 transition-colors duration-150"
        />
      </div>

      {/* Details */}
      <div class="mb-6">
        <label for="details" class="block text-sm font-medium text-primary mb-1.5">{t('form.details')}</label>
        <textarea
          id="details"
          name="details"
          rows="3"
          placeholder={t('form.detailsPlaceholder')}
          class="w-full px-4 py-2.5 rounded-lg border border-gray-200 text-sm text-slate-body placeholder:text-gray-400 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/20 transition-colors duration-150 resize-y"
        ></textarea>
      </div>

      {/* Submit */}
      <button
        type="submit"
        class="inline-flex items-center gap-2 bg-whatsapp hover:bg-whatsapp-hover text-white font-medium px-6 py-3 rounded-lg transition-colors duration-150"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        {t('form.submit')}
      </button>
    </form>
  </div>
</section>

<script>
  import { config } from '../config';

  const form = document.getElementById('enquiry-form') as HTMLFormElement;
  const errorEl = document.getElementById('service-error');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const selectedServices = formData.getAll('services') as string[];

      if (selectedServices.length === 0) {
        errorEl?.classList.remove('hidden');
        return;
      }
      errorEl?.classList.add('hidden');

      const lang = document.documentElement.lang || 'en';
      const isEn = lang === 'en';

      const serviceNames: Record<string, Record<string, string>> = {
        cctv: { en: 'CCTV Installation & Repair', mr: 'CCTV इन्स्टॉलेशन आणि दुरुस्ती' },
        ro: { en: 'RO Water Purifier', mr: 'RO वॉटर प्युरिफायर' },
        epbx: { en: 'EPBX Systems', mr: 'EPBX सिस्टम' },
        biometric: { en: 'Biometric & Access Control', mr: 'बायोमेट्रिक आणि अॅक्सेस कंट्रोल' },
        amc: { en: 'Annual Maintenance (AMC)', mr: 'वार्षिक मेंटेनन्स (AMC)' },
      };

      const selectedNames = selectedServices.map((id) => serviceNames[id]?.[lang] || id).join(', ');
      const name = (formData.get('name') as string)?.trim();
      const location = (formData.get('location') as string)?.trim();
      const details = (formData.get('details') as string)?.trim();

      let message = '';
      if (isEn) {
        message = `Hi, I'm interested in: ${selectedNames}`;
        if (name) message += `\nName: ${name}`;
        if (location) message += `\nLocation: ${location}`;
        if (details) message += `\nDetails: ${details}`;
      } else {
        message = `नमस्कार, मला या सेवांबद्दल चौकशी करायची आहे: ${selectedNames}`;
        if (name) message += `\nनाव: ${name}`;
        if (location) message += `\nठिकाण: ${location}`;
        if (details) message += `\nतपशील: ${details}`;
      }

      const url = `https://wa.me/${config.whatsappNumber}?text=${encodeURIComponent(message)}`;
      window.open(url, '_blank');
    });
  }
</script>
