---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { config } from '../config';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="areas" class="bg-off-white">
  <div class="max-w-[1100px] mx-auto px-5 md:px-8 py-20 md:py-28">
    {/* Section heading */}
    <div class="mb-10">
      <span class="text-[15px] uppercase tracking-widest text-primary font-medium">{t('areas.label')}</span>
      <div class="w-12 h-[3px] bg-accent mt-2.5 mb-4"></div>
      <h2 class="font-heading font-semibold text-[30px] md:text-[40px] text-primary">{t('areas.heading')}</h2>
    </div>

    <p class="text-slate-body text-[16px] md:text-[17px] leading-relaxed mb-6 max-w-[520px]">
      {t('areas.description')}
    </p>

    {/* District chips */}
    <div class="flex flex-wrap gap-3 mb-6">
      {config.areas.map((area) => (
        <span class="inline-flex items-center px-5 py-2 rounded-lg border-2 border-primary text-primary font-medium text-sm">
          {area}
        </span>
      ))}
    </div>

    <p class="text-sm text-gray-500">
      {t('areas.other')}
    </p>
  </div>
</section>
