---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { config } from '../config';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="areas" class="bg-off-white">
  <div class="max-w-[1100px] mx-auto px-5 md:px-8 py-20 md:py-28">
    {/* Section heading */}
    <div class="mb-10">
      <span class="text-[15px] uppercase tracking-widest text-primary font-medium">{t('areas.label')}</span>
      <div class="w-12 h-[3px] bg-accent mt-1 mb-2"></div>
      <h2 class="font-heading font-semibold text-[30px] md:text-[40px] text-primary">{t('areas.heading')}</h2>
    </div>

    <p class="text-slate-body text-[16px] md:text-[17px] leading-relaxed mb-6 max-w-[520px]">
      {t('areas.description')}
    </p>

    {/* District chips */}
    <div class="flex flex-wrap gap-3 mb-6">
      {config.areas.map((area) => (
        <span class="inline-flex items-center gap-2 px-4 py-2.5 bg-white rounded-md shadow-[0_1px_3px_rgba(0,0,0,0.08)] text-primary font-medium text-sm border border-gray-100">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          {area}
        </span>
      ))}
    </div>

    <p class="text-sm text-gray-500">
      {t('areas.other')}
    </p>
  </div>
</section>
